{
  "name": "opta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador de regimes tributários na Reforma Tributária do Consumo (2026–2033).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "mutation": "stryker run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "oracledb": "^26.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^10.0.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.9.0",
    "@types/oracledb": "^26.0.1",
    "@vitest/coverage-v8": "^2.1.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.14.0",
    "fast-check": "^4.10.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
