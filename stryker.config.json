{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["src/domain/**/*.ts", "src/application/**/*.ts", "!src/domain/ports/**", "!src/domain/taxes/tax-strategy.ts", "!src/domain/taxes/customer-credit-policy.ts", "!src/domain/simples/das-component.ts", "!src/domain/simples/simples-annex.ts", "!src/domain/presumption/activity-kind.ts", "!src/domain/comparison/burden-category.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "tempDirName": ".stryker-tmp",
  "thresholds": { "high": 90, "low": 85, "break": 85 }
}
